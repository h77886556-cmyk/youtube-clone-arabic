# قاعدة البيانات PostgreSQL
# محلياً: رابط قاعدة البيانات المحلية. وفي الإنتاج على Neon: رابط الـ pool
# (المجمّع) — انسخه من لوحة Neon وسيب ?sslmode=require في آخره.
DATABASE_URL="postgresql://user:password@localhost:5432/youtube_clone?schema=public"
# الرابط المباشر غير المجمّع — الـ migrations بتحتاجه (Neon بيدّيه من نفس صفحة
# الاتصال باسم "Direct connection"). محلياً: حط نفس قيمة DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/youtube_clone?schema=public"

# NextAuth — ولّد سراً بـ: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"
# في الإنتاج: لازم يكون رابط Vercel بتاعك بالظبط (من غير / في الآخر)، مثال:
# NEXTAUTH_URL="https://youtube-clone-arabic.vercel.app"
# محلياً: سيبه http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — من Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary — رفع الفيديوهات والصور المصغرة
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# اسم الـ unsigned upload preset اللي هتعمله في Cloudinary (لازم يطابق الاسم هناك)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="youtube-clone"
